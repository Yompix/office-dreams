<Project Sdk="Microsoft.NET.Sdk">
  <!-- IL2CPP-игры, BepInEx 6 bleeding edge (Unity.IL2CPP, .NET 6). -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>UnityBoost</AssemblyName>
    <RootNamespace>UnityBoost</RootNamespace>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);IL2CPP</DefineConstants>
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
    <Version>1.0.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <RefsDir Condition="'$(RefsDir)' == ''">$(MSBuildThisFileDirectory)../../build/refs</RefsDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Shared/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="BepInEx.Core"><HintPath>$(RefsDir)/bep6/BepInEx.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Unity.IL2CPP"><HintPath>$(RefsDir)/bep6/BepInEx.Unity.IL2CPP.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Unity.Common"><HintPath>$(RefsDir)/bep6/BepInEx.Unity.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(RefsDir)/bep6/Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Common"><HintPath>$(RefsDir)/bep6/Il2CppInterop.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2Cppmscorlib"><HintPath>$(RefsDir)/bep6/Il2Cppmscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(RefsDir)/bep6/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
