<Project Sdk="Microsoft.NET.Sdk">
  <!-- Mono-игры, BepInEx 5.4.x. net35 — чтобы работало и в старых Unity (.NET 3.5) и в новых. -->
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>UnityBoost</AssemblyName>
    <RootNamespace>UnityBoost</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
    <Version>1.0.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RefsDir Condition="'$(RefsDir)' == ''">$(MSBuildThisFileDirectory)../../build/refs</RefsDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Shared/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(RefsDir)/bep5/BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(RefsDir)/bep5/UnityEngine.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
