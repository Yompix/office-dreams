<?xml version="1.0" encoding="utf-8"?>
<!-- Hush Till Six для Android (Google Play). Версия и номер сборки подставляет tools/android/build.js (из tools/desktop/package.json).
     Разрешения: только вибрация (дрожь телефона на скримерах). Интернет не нужен — вся игра внутри приложения. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.yompix.hushtillsix">
  <uses-permission android:name="android.permission.VIBRATE" />
  <!-- WebGL 2 = OpenGL ES 3.0: без него «Кино» не работает -->
  <uses-feature android:glEsVersion="0x00030000" android:required="true" />
  <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
  <uses-feature android:name="android.hardware.gamepad" android:required="false" />
  <!-- экран поворачивает сама игра (альбомный 16:9 по умолчанию, книжный — в настройках): ни один не обязателен для установки -->
  <uses-feature android:name="android.hardware.screen.landscape" android:required="false" />
  <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />
  <supports-screens android:smallScreens="true" android:normalScreens="true" android:largeScreens="true" android:xlargeScreens="true" android:anyDensity="true" />
  <application android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:theme="@style/Game"
      android:allowBackup="true" android:hardwareAccelerated="true" android:isGame="true" android:appCategory="game"
      android:enableOnBackInvokedCallback="true" android:supportsRtl="false">
    <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask"
        android:screenOrientation="userLandscape" android:resizeableActivity="true" android:windowSoftInputMode="adjustNothing"
        android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection|locale">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
    <!-- WebView не отправляет в Google статистику использования -->
    <meta-data android:name="android.webkit.WebView.MetricsOptOut" android:value="true" />
  </application>
</manifest>
