ы"], [1.12, "прекратились"], [2.2, "Как отрезало"]]}, "dawn_1": {"t": "Михалыч вышел из круга. Ноги его не держали. Я подставил плечо.", "dur": 4.56, "w": [[0.0, "Михалыч"], [0.65, "вышел из"], [1.29, "круга Ноги"], [2.08, "его не"], [2.57, "держали Я"], [3.28, "подставил"], [4.08, "плечо"]]}, "dawn_2": {"t": "Мы вышли под дождь. Небо было серое. Утро.", "dur": 3.68, "w": [[0.0, "Мы вышли"], [0.83, "под дождь"], [1.75, "Небо было"], [2.67, "серое Утро"]]}, "dawn_3": {"t": "Михалыч долго хлопал по карманам. Нашёл мятую сигарету. Закурил.", "dur": 4.64, "w": [[0.0, "Михалыч"], [0.64, "долго хлопал"], [1.58, "по карманам"], [2.44, "Нашёл мятую"], [3.3, "сигарету"], [4.01, "Закурил"]]}, "dawn_4": {"t": "— Спасибо, сынок. Месяц я неба не видел.", "dur": 3.46, "w": [[0.0, "Спасибо"], [0.79, "сынок Месяц"], [2.3, "я неба"], [2.8, "не видел"]], "who": "МИХАЛЫЧ"}, "dawn_5": {"t": "— Но слушай. Сегодня ночью оно будет ждать уже тебя.", "dur": 3.73, "w": [[0.0, "Но слушай"], [0.68, "Сегодня"], [1.73, "ночью оно"], [2.34, "будет ждать"], [3.09, "уже тебя"]], "who": "МИХАЛЫЧ"}, "rules_0": {"t": "Я остался. Правила держат меня живым. Значит, держусь за правила.", "dur": 4.48, "w": [[0.0, "Я остался"], [0.7, "Правила"], [1.33, "держат меня"], [2.17, "живым Значит"], [3.09, "держусь за"], [3.86, "правила"]]}, "rules_1": {"t": "Полтора часа я смотрел в мониторы. Тринадцатая больше не включалась.", "dur": 4.4, "w": [[0.0, "Полтора часа"], [0.84, "я смотрел"], [1.47, "в мониторы"], [2.17, "Тринадцатая"], [3.0, "больше не"], [3.64, "включалась"]]}, "rules_2": {"t": "Михалыч сидел там, внизу. Я старался об этом не думать.", "dur": 4.16, "w": [[0.0, "Михалыч"], [0.68, "сидел там"], [1.44, "внизу Я"], [2.04, "старался об"], [2.96, "этом не"], [3.56, "думать"]]}, "call540_0": {"t": "В 05:40 зазвонил телефон. «Катя».", "dur": 2.96, "w": [[0.0, "В 05"], [0.47, "40 зазвонил"], [1.67, "телефон Катя"]]}, "call540_1": {"t": "Катя спит. Я сам её разбудил два часа назад.", "dur": 3.44, "w": [[0.0,