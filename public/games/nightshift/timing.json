{"l01": {"t": "Эту камеру я смотрю каждую ночь. И каждую ночь он стоит чуть ближе.", "dur": 6.13, "w": [[0.0, "Эту камеру"], [1.01, "я смотрю"], [1.82, "каждую ночь"], [2.93, "И каждую"], [3.74, "ночь он"], [4.46, "стоит чуть"], [5.46, "ближе"]]}, "l02": {"t": "В «Горизонт» искали ночного охранника. Смена с трёх до шести. Платили втрое. Я не спросил почему.", "dur": 8.56, "w": [[0.0, "В Горизонт"], [0.99, "искали"], [1.68, "ночного"], [2.46, "охранника"], [3.43, "Смена с"], [4.13, "трёх до"], [4.82, "шести"], [5.42, "Платили"], [6.21, "втрое Я"], [6.9, "не спросил"], [7.87, "почему"]]}, "l03": {"t": "Сменщик ждал меня уже в куртке. Ключи и листок держал наготове.", "dur": 5.44, "w": [[0.0, "Сменщик ждал"], [1.11, "меня уже"], [1.86, "в куртке"], [2.61, "Ключи и"], [3.28, "листок"], [3.94, "держал"], [4.6, "наготове"]]}, "l04": {"t": "И почти выбежал на улицу.", "dur": 1.89, "w": [[0.0, "И почти"], [0.57, "выбежал на"], [1.36, "улицу"]]}, "l05": {"t": "Первое. В три ночи на седьмом этаже включится свет. Не поднимайся.", "dur": 6.69, "w": [[0.0, "Первое В"], [0.89, "три ночи"], [1.78, "на седьмом"], [2.88, "этаже"], [3.55, "включится"], [4.65, "свет Не"], [5.44, "поднимайся"]]}, "l06": {"t": "Второе. Если лифт приехал сам, не заходи.", "dur": 5.89, "w": [[0.0, "Второе Если"], [1.78, "лифт приехал"], [3.7, "сам не"], [4.69, "заходи"]]}, "l07": {"t": "Третье. После полуночи никого не впускай. Даже своих.", "dur": 6.24, "w": [[0.0, "Третье После"], [1.55, "полуночи"], [2.72, "никого не"], [3.9, "впускай Даже"], [5.44, "своих"]]}, "l08": {"t": "Четвёртое. Камеру тринадцать не включай.", "dur": 4.13, "w": [[0.0, "Четвёртое"], [1.08, "Камеру"], [1.84, "тринадцать"], [3.01, "не включай"]]}, "l09": {"t": "А внизу кто-то приписал ручкой: третье правило — ложь. Впусти её. Подпись — М.", "dur": 7.09, "w": [[0.0, "А внизу"], [0.75, "кто-то"], [1.5, "приписал"], [2.45, "ручкой"], [3.2, "третье"], [3.95, "правило ложь"], [5.2, "Впусти её"], [6.15, "Подпись М"]]}, "l10": {"t": "Над 