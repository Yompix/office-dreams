]]}, "cam13b_1": {"t": "Серверная. На полу — круг из соли. В круге сидел человек.", "dur": 4.96, "w": [[0.0, "Серверная На"], [1.2, "полу круг"], [2.1, "из соли"], [2.82, "В круге"], [3.53, "сидел"], [4.15, "человек"]]}, "cam13b_2": {"t": "Михалыч. Живой. Худой, заросший. Он поднял к камере листок.", "dur": 5.28, "w": [[0.0, "Михалыч"], [0.82, "Живой Худой"], [1.92, "заросший Он"], [3.03, "поднял к"], [3.84, "камере"], [4.56, "листок"]]}, "cam13b_3": {"t": "А за кругом, в темноте, кто-то стоял. И смотрел не на него. На меня.", "dur": 6.48, "w": [[0.0, "А за"], [0.48, "кругом в"], [1.36, "темноте"], [2.25, "кто-то стоял"], [3.56, "И смотрел"], [4.55, "не на"], [5.13, "него На"], [5.91, "меня"]]}, "down_0": {"t": "Лифт я не тронул. Лестница. Минус первый. Минус второй.", "dur": 6.0, "w": [[0.0, "Лифт я"], [0.78, "не тронул"], [1.91, "Лестница"], [3.03, "Минус первый"], [4.52, "Минус второй"]]}, "down_1": {"t": "Пахло сыростью и свечным воском. Фонарик мигал.", "dur": 4.56, "w": [[0.0, "Пахло"], [0.62, "сыростью и"], [1.62, "свечным"], [2.43, "воском"], [3.14, "Фонарик"], [3.95, "мигал"]]}, "basement_0": {"t": "Железная дверь. «Серверная». Под дверью — полоска тёплого света.", "dur": 5.2, "w": [[0.0, "Железная"], [0.82, "дверь"], [1.38, "Серверная"], [2.28, "Под дверью"], [3.19, "полоска"], [3.92, "тёплого"], [4.65, "света"]]}, "basement_1": {"t": "— Тёмыч? Ты? Заходи, сынок, открыто.", "dur": 4.03, "w": [[0.0, "Тёмыч Ты"], [1.48, "Заходи сынок"], [3.22, "открыто"]], "who": "МИХАЛЫЧ"}, "basement_2": {"t": "Голос был его. Хриплый, добрый. Только мы с ним ни разу не виделись.", "dur": 5.28, "w": [[0.0, "Голос был"], [0.81, "его Хриплый"], [1.78, "добрый"], [2.41, "Только мы"], [3.22, "с ним"], [3.68, "ни разу"], [4.31, "не виделись"]]}, "basement_3": {"t": "Откуда он знает, как меня зовут? На листке было: стучи трижды.", "dur": 4.16, "w": [[0.0, "Откуда он"], [0.7, "знает как"], [1.39, "меня зовут"], [2.16, "На листке"], [2.85, "было стучи"], [3.62, "трижды"]]}, "knock3_