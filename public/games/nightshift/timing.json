, "w": [[0.0, "Михалыч"], [0.7, "работал тут"], [1.62, "до меня"], [2.23, "Месяц назад"], [3.15, "он пропал"], [3.92, "прямо на"], [4.6, "смене"]]}, "l11": {"t": "Ровно в три на седьмом этаже зажёгся свет. Лампа за лампой. Я не поднялся. Только смотрел.", "dur": 9.57, "w": [[0.0, "Ровно в"], [0.84, "три на"], [1.55, "седьмом"], [2.5, "этаже"], [3.22, "зажёгся свет"], [4.6, "Лампа за"], [5.54, "лампой Я"], [6.48, "не поднялся"], [7.75, "Только"], [8.58, "смотрел"]]}, "l12": {"t": "Потом сверху приехал лифт. Сам. Пустой. Двери стояли открытыми ровно минуту. Я считал каждую секунду.", "dur": 9.81, "w": [[0.0, "Потом сверху"], [1.28, "приехал лифт"], [2.56, "Сам Пустой"], [3.64, "Двери стояли"], [4.92, "открытыми"], [5.99, "ровно минуту"], [7.27, "Я считал"], [8.14, "каждую"], [8.91, "секунду"]]}, "l13": {"t": "Камеру тринадцать я не трогал.  Она включилась сама.", "dur": 5.33, "w": [[0.0, "Камеру"], [0.78, "тринадцать я"], [2.08, "не трогал"], [3.07, "Она"], [3.54, "включилась"], [4.73, "сама"]]}, "l14": {"t": "В половине четвёртого в дверь постучали. Это была Катя. Моя сестра. Она живёт в другом городе.", "dur": 9.09, "w": [[0.0, "В половине"], [1.06, "четвёртого в"], [2.32, "дверь"], [2.97, "постучали"], [4.02, "Это была"], [4.88, "Катя Моя"], [5.73, "сестра Она"], [6.78, "живёт в"], [7.54, "другом"], [8.29, "городе"]]}, "l15": {"t": "Тёмыч. Так меня звала только она. В детстве.", "dur": 4.13, "w": [[0.0, "Тёмыч Так"], [0.97, "меня звала"], [2.04, "только она"], [3.12, "В детстве"]]}, "l16": {"t": "Я посмотрел на камеру у входа. Там, где она стояла, были одни помехи.", "dur": 6.05, "w": [[0.0, "Я посмотрел"], [1.1, "на камеру"], [2.01, "у входа"], [2.72, "Там где"], [3.43, "она стояла"], [4.44, "были одни"], [5.34, "помехи"]]}, "l17": {"t": "Правило говорит: не впускай. Михалыч пишет: впусти. А сестра плачет за стеклом.", "dur": 7.73, "w": [[0.0, "Правило"], [0.88, "говорит не"], [1.95, "впускай"], [2.82, "Михалыч"], [3.69, "пишет впусти"], [4.97, "А сестра"], [5.84,