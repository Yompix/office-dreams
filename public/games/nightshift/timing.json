{"l01": {"t": "Эту камеру я смотрю каждую ночь. И каждую ночь он стоит чуть ближе.", "dur": 4.72, "w": [[0.0, "Эту камеру"], [0.66, "я смотрю"], [1.16, "каждую ночь"], [1.85, "И каждую"], [3.16, "ночь он"], [3.62, "стоит чуть"], [4.36, "ближе"]]}, "l02": {"t": "В «Горизонт» искали ночного охранника. Смена с трёх до шести. Платили втрое. Я не спросил почему.", "dur": 7.28, "w": [[0.0, "В Горизонт"], [0.68, "искали"], [1.17, "ночного"], [1.7, "охранника"], [2.37, "Смена с"], [3.11, "трёх до"], [3.58, "шести"], [4.02, "Платили"], [4.79, "втрое Я"], [5.28, "не спросил"], [6.69, "почему"]]}, "l03": {"t": "Сменщик ждал меня уже в куртке. Ключи и листок держал наготове.", "dur": 4.56, "w": [[0.0, "Сменщик ждал"], [0.81, "меня уже"], [1.34, "в куртке"], [1.92, "Ключи и"], [2.82, "листок"], [3.36, "держал"], [3.82, "наготове"]]}, "l04": {"t": "И почти выбежал на улицу.", "dur": 1.82, "w": [[0.0, "И почти"], [0.6, "выбежал на"], [1.3, "улицу"]]}, "l05": {"t": "Первое. В три ночи на седьмом этаже включится свет. Не поднимайся.", "dur": 5.17, "w": [[0.0, "Первое В"], [0.58, "три ночи"], [1.68, "на седьмом"], [2.32, "этаже"], [2.76, "включится"], [3.43, "свет Не"], [4.4, "поднимайся"]]}, "l06": {"t": "Второе. Если лифт приехал сам, не заходи.", "dur": 4.08, "w": [[0.0, "Второе Если"], [1.52, "лифт приехал"], [2.5, "сам не"], [3.42, "заходи"]]}, "l07": {"t": "Третье. После полуночи никого не впускай. Даже своих.", "dur": 4.4, "w": [[0.0, "Третье После"], [1.36, "полуночи"], [1.96, "никого не"], [2.61, "впускай Даже"], [3.94, "своих"]]}, "l08": {"t": "Четвёртое. Камеру тринадцать не включай.", "dur": 2.72, "w": [[0.0, "Четвёртое"], [0.61, "Камеру"], [1.27, "тринадцать"], [1.98, "не включай"]]}, "l09": {"t": "А внизу кто-то приписал ручкой: третье правило — ложь. Впусти её. Подпись — М.", "dur": 8.48, "w": [[0.0, "А внизу"], [0.5, "кто-то"], [0.99, "приписал"], [1.61, "ручкой"], [2.72, "третье"], [3.2, "правило ложь"], [5.55, "Впусти её"], [7.07, "Подпись М"]]}, "l10": {"t": "Над пультом висел пропуск прошлого охранника. «Михайлов». Месяц назад он ушёл в обход и не вернулся.", "dur": 8.72, "w": [[0.0, "Над пультом"], [0.87, "висел"], [1.35, "пропуск"], [1.93, "прошлого"], [2.53, "охранника"], [4.19, "Михайлов"], [6.02, "Месяц назад"], [6.78, "он ушёл"], [7.28, "в обход"], [7.82, "и не"], [8.1, "вернулся"]]}, "l11": {"t": "Я остался. Свет на седьмом горел, коридор был пуст. А потом я понял, что не слышу дождя. Совсем.", "dur": 8.8, "w": [[0.0, "Я остался"], [0.71, "Свет на"], [2.08, "седьмом"], [2.6, "горел"], [2.99, "коридор был"], [3.9, "пуст А"], [5.58, "потом я"], [6.04, "понял что"], [6.63, "не слышу"], [7.13, "дождя Совсем"]]}, "l12": {"t": "Потом звякнул лифт. Его никто не вызывал. Двери открылись и не закрывались. Я начал считать.", "dur": 8.38, "w": [[0.0, "Потом"], [0.48, "звякнул лифт"], [1.29, "Его никто"], [2.33, "не вызывал"], [2.97, "Двери"], [4.27, "открылись и"], [5.18, "не"], [5.4, "закрывались"], [6.16, "Я начал"], [7.65, "считать"]]}, "l13": {"t": "Камеру тринадцать я не трогал. Она включилась сама. Кнопка не работала — оставался шнур.", "dur": 6.16, "w": [[0.0, "Камеру"], [0.47, "тринадцать я"], [1.14, "не трогал"], [2.04, "Она"], [2.29, "включилась"], [2.91, "сама Кнопка"], [4.13, "не работала"], [4.8, "оставался"], [5.84, "шнур"]]}, "l14": {"t": "Половина четвёртого. За стеклом стояла Катя. Моя сестра. Которая живёт за триста километров.", "dur": 8.78, "w": [[0.0, "Половина"], [0.64, "четвёртого"], [2.61, "За стеклом"], [3.24, "стояла Катя"], [3.95, "Моя сестра"], [5.37, "Которая"], [7.07, "живёт за"], [7.55, "триста"], [7.99, "километров"]]}, "l15": {"t": "Тёмыч. Так меня звала только она. В детстве.", "dur": 4.0, "w": [[0.0, "Тёмыч Так"], [1.44, "меня звала"], [2.19, "только она"], [3.31, "В детстве"]]}, "l16": {"t": "Я посмотрел на камеру у входа. Там, где она стояла, были одни помехи.", "dur": 5.28, "w": [[0.0, "Я посмотрел"], [0.8, "на камеру"], [1.41, "у входа"], [2.83, "Там где"], [3.31, "она стояла"], [4.17, "были одни"], [4.81, "помехи"]]}, "l17": {"t": "Я взялся за ключ. С той стороны она приложила ладонь к стеклу. Точно напротив.", "dur": 5.92, "w": [[0.0, "Я взялся"], [0.49, "за ключ"], [0.93, "С той"], [2.09, "стороны она"], [2.8, "приложила"], [3.41, "ладонь к"], [3.94, "стеклу Точно"], [5.2, "напротив"]]}, "ch_guard": {"t": "На, держи. Листок прочти. И не умничай — делай, как там написано.", "dur": 5.4, "w": [[0.0, "На держи"], [0.59, "Листок"], [1.61, "прочти И"], [2.23, "не умничай"], [3.48, "делай как"], [4.37, "там написано"]], "who": "СМЕНЩИК"}, "ch_monster": {"t": "Вот ты где.", "dur": 1.68, "w": [[0.0, "Вот ты"], [1.02, "где"]], "who": "???"}, "ch_katya": {"t": "Тёмыч… Открой. Пожалуйста. Я замёрзла.", "dur": 4.8, "w": [[0.0, "Тёмыч Открой"], [1.77, "Пожалуйста Я"], [3.78, "замёрзла"]], "who": "КАТЯ?"}, "ch_whisper": {"t": "Открой мне… Открой.", "dur": 3.49, "w": [[0.0, "Открой мне"], [1.89, "Открой"]]}, "intro_2": {"t": "Маме нужно было лечение. Когда платят втрое, вопросов не задают.", "dur": 4.56, "w": [[0.0, "Маме нужно"], [0.69, "было лечение"], [1.45, "Когда платят"], [2.84, "втрое"], [3.26, "вопросов не"], [3.98, "задают"]]}, "keys_a_0": {"t": "Я взял ключи. Тёплые, мокрые от пота. Видно, весь вечер сжимал их в кулаке.", "dur": 6.24, "w": [[0.0, "Я взял"], [0.4, "ключи Тёплые"], [1.79, "мокрые от"], [2.83, "пота Видно"], [4.41, "весь вечер"], [5.03, "сжимал их"], [5.59, "в кулаке"]]}, "keys_b_0": {"t": "— А почему втрое-то?", "dur": 1.12, "w": [[0.0, "А почему"], [0.5, "втрое-то"]]}, "keys_b_1": {"t": "— Прошлый тоже спрашивал. Михалыч.", "dur": 3.0, "w": [[0.0, "Прошлый тоже"], [0.89, "спрашивал"], [2.3, "Михалыч"]], "who": "СМЕНЩИК"}, "keys_b_2": {"t": "— Месяц назад пропал. Прямо на смене. Куртка на стуле осталась.", "dur": 5.04, "w": [[0.0, "Месяц назад"], [0.69, "пропал Прямо"], [2.15, "на смене"], [2.65, "Куртка на"], [3.92, "стуле"], [4.33, "осталась"]], "who": "СМЕНЩИК"}, "note_0": {"t": "Листок в клетку. Четыре правила. Четыре разных почерка.",