8, "there"], [4.34, "listening"], [4.58, "to"], [4.8, "the"], [4.92, "empty"], [5.12, "building"], [5.52, "hum"]]}, "knock_4": {"t": "The yellow raincoat. The one I gave her for her twentieth birthday.", "dur": 3.73, "w": [[0.12, "The"], [0.36, "yellow"], [0.56, "raincoat"], [1.58, "The"], [1.78, "one"], [1.9, "I"], [2.02, "gave"], [2.2, "her"], [2.44, "for"], [2.6, "her"], [2.97, "twentieth"], [3.2, "birthday"]]}, "knock_7": {"t": "She was sobbing right into the glass. But it only fogged up on my side.", "dur": 4.95, "w": [[0, "She"], [0.28, "was"], [0.42, "sobbing"], [0.9, "right"], [1.2, "into"], [1.48, "the"], [1.66, "glass"], [2.62, "But"], [3.18, "it"], [3.3, "only"], [3.42, "fogged"], [3.94, "up"], [4.02, "on"], [4.2, "my"], [4.34, "side"]]}, "knock_8": {"t": "And she never blinked. Not once.", "dur": 3.59, "w": [[0.12, "And"], [1.26, "she"], [1.4, "never"], [1.62, "blinked"], [2.68, "Not"], [3.06, "once"]]}, "open_0": {"t": "I turned the key.", "dur": 1.29, "w": [[0.12, "I"], [0.4, "turned"], [0.6, "the"], [0.82, "key"]]}, "open_1": {"t": "She threw her arms around my neck. Ice cold. Soaked through.", "dur": 4.55, "w": [[0.12, "She"], [0.46, "threw"], [0.68, "her"], [0.88, "arms"], [1.16, "around"], [1.42, "my"], [1.64, "neck"], [2.54, "Ice"], [2.76, "cold"], [3.56, "Soaked"], [3.86, "through"]]}, "open_2": {"t": "— It's okay, it's okay. You're inside. You're safe now.", "dur": 4.45, "w": [[0.12, "It's"], [0.68, "okay"], [1.22, "it's"], [1.46, "okay"], [2.2, "You're"], [2.5, "inside"], [3.42, "You're"], [3.66, "safe"], [3.92, "now"]]}, "open_3": {"t": "She stopped crying. Instantly. As if someone had hit mute.", "dur": 4.39, "w": [[0.12, "She"], [0.68, "stopped"], [0.92, "crying"], [1.78, "Instantly"], [2.7, "As"], [3.08, "if"], [3.2, "someone"], [3.48, "had"], [3.68, "hit"], [3.88, "mute"]]}, "open_4": {"t": "She didn't smell of rain. She smelled of a cellar. Of damp earth.", "dur": 4.77, "w": [[0.12, "She"], [0.66, "didn't"], [0.92, "smell"], [1.12, "of"], [1.32, "rain"], [2.12, "She"], [2.34, "smelled"], [2.56, "of"], [2.76, "a"], [2.84, "cellar"], [3.18, "Of"], [3.86, "damp"], [4.1, "earth"]]}, "open_5": {"t": "My phone rang in my pocket. The screen said: \"Katya.\"", "dur": 3.77, "w": [[0.12, "My"], [0.36, "phone"], [0.64, "rang"], [0.84, "in"], [1.0, "my"], [1.12, "pocket"], [2.0, "The"], [2.14, "screen"], [2.36, "said"], [3.52, "Katya"]]}, "open_6": {"t": "Katya was standing right next to me. Her hands were empty. And the phone kept ringing: \"Katya.\"", "dur": 6.41, "w": [[0.12, "Katya"], [0.9, "was"], [1.08, "standing"], [1.36, "right"], [1.74, "next"], [2.02, "to"], [2.22, "me"], [2.82, "Her"], [2.98, "hands"], [3.2, "were"], [3.4, "empty"], [4.3, "And"], [4.38, "the"], [4.48, "phone"], [4.7, "kept"], [4.96, "ringing"], [6.16, "Katya"]]}, "open_7": {"t": "I looked up. The lobby was empty. Just wet footprints leading to the elevator.", "dur": 5.17, "w": [[0.12, "I"], [0.66, "looked"], [0.82, "up"], [1.52, "The"], [1.76, "lobby"], [1.94, "was"], [2.2, "empty"], [2.98, "Just"], [3.26, "wet"], [3.52, "footprints"], [3.94, "leading"], [4.32, "to"], [4.58, "the"], [4.68, "elevator"]]}, "open_8": {"t": "The elevator was going up. Three. Five. Seven.", "dur": 4.31, "w": [[0.12, "The"], [0.44, "elevator"], [0.76, "was"], [1.02, "going"], [1.3, "up"], [2.1, "Three"], [2.8, "Five"], [3.66, "Seven"]]}, "open_9": {"t": "Seventh-floor camera. At the end of the corridor — a yellow raincoat. She slowly turned around.", "dur": 6.44, "w": [[0.12, "Seventh-floor"], [1.05, "camera"], [2.15, "At"], [2.21, "the"], [2.33, "end"], [2.45, "of"], [2.57, "the"], [2.67, "corridor"], [3.47, "a"], [3.57, "yellow"], [3.81, "raincoat"], [4.93, "She"], [5.07, "slowly"], [5.45, "turned"], [5.81, "around"]]}, "open_10": {"t": "It wasn't her face. And it was smiling into the camera.", "dur": 3.57, "w": [[0.12, "It"], [0.34, "wasn't"], [0.64, "her"], [0.78, "face"], [1.7, "And"], [1.9, "it"], [2.0, "was"], [2.1, "smiling"], [2.46, "into"], [2.82, "the"], [2.98, "camera"]]}, "open_11": {"t": "Wet ink. Mikhalych never wrote that note. It was written tonight. For me.", "dur": 5.43, "w": [[0.12, "Wet"], [0.46, "ink"], [1.46, "Mikhalych"], [2.1, "never"], [2.32, "wrote"], [2.56, "that"], [2.76, "note"], [3.58, "It"], [3.64, "was"], [3.76, "written"], [3.92, "tonight"], [4.72, "For"], [5.0, "me"]]}, "open_12": {"t": "It forged his handwriting. And I opened the door for it myself.", "dur": 4.03, "w": [[0, "It"], [0.22, "forged"], [0.5, "his"], [0.86, "handwriting"], [2.0, "And"], [2.24, "I"], [2.36, "opened"], [2.54, "the"], [2.8, "door"], [3.02, "for"], [3.2, "it"], [3.34, "myself"]]}, "open_13": {"t": "The elevator hummed. Seven. Six. Five. It was coming down.", "dur": 5.59, "w": [[0.12, "The"], [0.2, "elevator"], [0.5, "hummed"], [1.94, "Seven"], [2.58, "Six"], [3.74, "Five"], [4.48, "It"], [4.66, "was"], [4.78, "coming"], [5.04, "down"]]}, "booth_0": {"t": "I locked the booth. Turned off the lamp. Slid down to the floor under the desk.", "dur": 4.55, "w": [[0.12, "I"], [0.24, "locked"], [0.42, "the"], [0.64, "booth"], [1.26, "Turned"], [1.52, "off"], [1.72, "the"], [1.88, "lamp"], [2.56, "Slid"], [2.72, "down"], [3.04, "to"], [3.2, "the"], [3.3, "floor"], [3.56, "under"], [3.82, "the"], [3.98, "desk"]]}, "booth_1": {"t": "Ding. The elevator doors. Footsteps. Bare, wet. Closer.", "dur": 5.15, "w": [[0.12, "Ding"], [1.16, "The"], [1.22, "elevator"], [1.5, "doors"], [2.42, "Footsteps"], [3.36, "Bare"], [4.08, "wet"], [4.58, "Closer"]]}, "booth_win_0": {"t": "The footsteps circled the booth until dawn. Then they stopped.", "dur": 3.43, "w": [[0.12, "The"], [0.14, "footsteps"], [0.44, "circled"], [0.92, "the"], [1.2, "booth"], [1.4, "until"], [1.72, "dawn"], [2.68, "Then"], [2.82, "they"], [2.96, "stopped"]]}, "booth_win_1": {"t": "At six the front door banged. My relief had arrived.", "dur": 3.49, "w": [[0.12, "At"], [0.36, "six"], [0.6, "the"], [0.92, "front"], [1.16, "door"], [1.38, "banged"], [2.2, "My"], [2.36, "relief"], [2.66, "had"], [2.98, "arrived"]]}, "booth_win_2": {"t": "He looked at me. And backed away. Slowly. Never turning his back.", "dur": 4.49, "w": [[0.12, "He"], [0.36, "looked"], [0.54, "at"], [0.72, "me"], [0.88, "And"], [1.44, "backed"], [1.6, "away"], [2.3, "Slowly"], [3.22, "Never"], [3.42, "turning"], [3.76, "his"], [4.02, "back"]]}, "booth_win_4": {"t": "I glanced at the booth glass. I was smiling. Wider than I know how.", "dur": 4.37, "w": [[0.12, "I"], [0.22, "glanced"], [0.38, "at"], [0.72, "the"], [0.8, "booth"], [0.96, "glass"], [1.84, "I"], [1.98, "was"], [2.08, "smiling"], [2.86, "Wider"], [3.2, "than"], [3.52, "I"], [3.62, "know"], [3.84, "how"]]}, "exit_0": {"t": "The emergency exit is at the end of the service corridor. Forty steps.", "dur": 4.13, "w": [[0.12, "The"], [0.34, "emergency"], [0.62, "exit"], [1.1, "is"], [1.4, "at"], [1.54, "the"], [1.66, "end"], [1.86, "of"], [2.0, "the"], [2.1, "service"], [2.42, "corridor"], [3.1, "Forty"], [3.5, "steps"]]}, "exit_1": {"t": "Something clicked behind me. The lights went out one by one. The dark was right on my heels.", "dur": 4.68, "w": [[0.12, "Something"], [0.52, "clicked"], [0.76, "behind"], [1.08, "me"], [1.64, "The"], [1.76, "lights"], [1.92, "went"], [2.12, "out"], [2.28, "one"], [2.52, "by"], [2.7, "one"], [3.18, "The"], [3.32, "dark"], [3.54, "was"], [3.72, "right"], [3.98, "on"], [4.12, "my"], [4.26, "heels"]]}, "sister_0": {"t": "I burst out into the rain. I ran until my lungs gave out.", "dur": 3.69, "w": [[0.12, "I"], [0.52, "burst"], [0.66, "out"], [0.92, "into"], [1.08, "the"], [1.28, "rain"], [1.86, "I"], [1.94, "ran"], [2.18, "until"], [2.48, "my"], [2.66, "lungs"], [2.86, "gave"], [3.18, "out"]]}, "sister_1": {"t": "The Horizon stood dark. Only one window was lit — on the seventh floor.", "dur": 4.49, "w": [[0.12, "The"], [0.14, "Horizon"], [0.36, "stood"], [0.88, "dark"], [1.2, "Only"], [1.9, "one"], [2.2, "window"], [2.58, "was"], [2.78, "lit"], [2.98, "on"], [3.44, "the"], [3.56, "seventh"], [3.8, "floor"]]}, "sister_2": {"t": "My phone rang. Katya.", "dur": 1.87, "w": [[0.12, "My"], [0.18, "phone"], [0.42, "rang"], [1.38, "Katya"]]}, "sister_5": {"t": "I was standing in the rain outside the Horizon. Three hundred kilometers from her door.", "dur": 4.77, "w": [[0.12, "I"], [0.26, "was"], [0.34, "standing"], [0.64, "in"], [0.9, "the"], [0.98, "rain"], [1.2, "outside"], [1.5, "the"], [1.86, "Horizon"], [2.46, "Three"], [2.74, "hundred"], [3.02, "kilometers"], [3.52, "from"], [4.12, "her"], [4.28, "door"]]}, "stay_0": {"t": "I didn't open it. She stopped crying. Instantly.", "dur": 3.62, "w": [[0, "I"], [0.24, "didn't"], [0.54, "open"], [0.8, "it"], [1.7, "She"], [1.88, "stopped"], [2.1, "crying"], [2.5, "Instantly"]]}, "stay_1": {"t": "And smiled. Far too wide. Katya never had that many teeth.", "dur": 6.17, "w": [[0, "And"], [1.66, "smiled"], [2.04, "Far"], [3.04, "too"], [3.32, "wide"], [4.15, "Katya"], [4.58, "never"], [4.94, "had"], [5.22, "that"], [5.4, "many"], [5.56, "teeth"]]}, "stay_2": {"t": "She knocked. Harder. Harder still. The glass shook in its frame.", "dur": 5.29, "w": [[0.12, "She"], [0.5, "knocked"], [1.32, "Harder"], [2.4, "Harder"], [2.62, "still"], [3.82, "The"], [3.82, "glass"], [4.04, "shook"], [4.4, "in"], [4.6, "its"], [4.7, "frame"]]}, "stay_4": {"t": "Then she walked away. Backwards. Never taking her eyes off me.", "dur": 4.29, "w": [[0.12, "Then"], [0.28, "she"], [0.46, "walked"], [0.62, "away"], [1.48, "Backwards"], [2.52, "Never"], [2.78, "taking"], [3.18, "her"], [3.4, "eyes"], [3.62, "off"], [3.84, "me"]]}, "stay_5": {"t": "I called Katya. One ring. Two. Three.", "dur": 3.63, "w": [[0.12, "I"], [0.14, "called"], [0.66, "Katya"], [0.99, "One"], [1.32, "ring"], [1.64, "Two"], [2.96, "Three"]]}, "stay_7": {"t": "— Where are you?", "dur": 1.35, "w": [[0.12, "Where"], [0.46, "are"], [0.68, "you"]]}, "stay_9": {"t": "— Nothing. Go back to sleep. And don't open the door to anyone. Not even me.", "dur": 5.09,