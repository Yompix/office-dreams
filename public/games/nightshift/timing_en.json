 "standing"], [3.76, "And"], [3.9, "it"], [4.0, "wasn't"], [4.28, "looking"], [4.54, "at"], [4.7, "him"], [5.34, "It"], [5.46, "was"], [5.56, "looking"], [5.82, "at"], [5.98, "me"]]}, "down_0": {"t": "I didn't touch the elevator. The stairs. Minus one. Minus two.", "dur": 4.73, "w": [[0.12, "I"], [0.56, "didn't"], [0.8, "touch"], [0.96, "the"], [1.18, "elevator"], [2.02, "The"], [2.12, "stairs"], [2.96, "Minus"], [3.18, "one"], [3.96, "Minus"], [4.16, "two"]]}, "down_1": {"t": "It smelled of damp and wax. Salt crunched under my feet.", "dur": 3.85, "w": [[0.12, "It"], [0.22, "smelled"], [0.4, "of"], [0.64, "damp"], [0.9, "and"], [1.22, "wax"], [2.0, "Salt"], [2.44, "crunched"], [2.98, "under"], [3.14, "my"], [3.36, "feet"]]}, "basement_0": {"t": "An iron door. \"Server Room.\" A strip of warm light underneath.", "dur": 5.03, "w": [[0, "An"], [0.28, "iron"], [0.58, "door"], [1.88, "Server"], [2.26, "Room"], [3.38, "A"], [3.46, "strip"], [3.7, "of"], [3.88, "warm"], [4.12, "light"], [4.44, "underneath"]]}, "basement_2": {"t": "A hoarse, kind voice. I'd never heard it before. And he knew my name.", "dur": 5.51, "w": [[0.12, "A"], [0.42, "hoarse"], [0.58, "kind"], [1.18, "voice"], [1.58, "I'd"], [2.68, "never"], [2.8, "heard"], [3.06, "it"], [3.2, "before"], [4.28, "And"], [4.46, "he"], [4.6, "knew"], [4.76, "my"], [4.94, "name"]]}, "basement_3": {"t": "Only Katya ever called me Tyoma. And the note said: knock three times.", "dur": 4.95, "w": [[0.12, "Only"], [0.28, "Katya"], [0.74, "ever"], [0.98, "called"], [1.22, "me"], [1.97, "Tyoma"], [2.56, "And"], [2.66, "the"], [2.76, "note"], [2.9, "said"], [3.22, "knock"], [3.84, "three"], [4.28, "times"]]}, "knock3_0": {"t": "I knocked. One. Two. Three.", "dur": 3.5, "w": [[0.12, "I"], [0.22, "knocked"], [0.42, "One"], [1.98, "Two"], [3.32, "Three"]]}, "knock3_1": {"t": "Silence. Then a bolt clanked. From the inside.", "dur": 3.99, "w": [[0.12, "Silence"], [1.92, "Then"], [2.06, "a"], [2.16, "bolt"], [2.36, "clanked"], [2.76,