; WHAT THE LAKE KEEPS — сюжетная игра с выборами (Godot 4.7). Сценарий — newgame/ch1–ch5.md, данные глав — data/ch*.json.
config_version=5

[application]
config/name="What the Lake Keeps"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"
config/project_settings_override="user://lake_renderer.cfg"
config/quit_on_go_back=false

[display]
window/handheld/orientation=4
window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
limits/opengl/max_lights_per_object=16
gl_compatibility/driver.windows="opengl3_angle"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=3
textures/default_filters/anisotropic_filtering_level.mobile=2

[importer_defaults]

texture={
"compress/lossy_quality": 0.85,
"compress/mode": 1
}
