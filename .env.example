# ===== Office Dreams — configuration =====
# Copy this file to .env and fill in the values.

# --- Telegram (required) ---
# Token from @BotFather → /newbot
BOT_TOKEN=
# Bot username without @, e.g. OfficeDreamsBot
BOT_USERNAME=
# Short name of the Mini App created in @BotFather → /newapp (the link will be t.me/<bot>/<short name>)
APP_SHORTNAME=play

# --- Server (required) ---
# Public HTTPS address of this server, without a trailing slash, e.g. https://game.example.com
PUBLIC_URL=
PORT=8080
# A long random string (sign sessions). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Password for the admin panel at /admin (long random string)
ADMIN_KEY=
# Your Telegram user id(s) — they may use the /stats bot command (comma separated)
ADMIN_TG_IDS=
# Set to 1 when running behind Caddy/Nginx/Cloudflare so the real client IP is used
TRUST_PROXY=1
# Where the database lives (keep it on a persistent disk!)
DB_PATH=data/officedreams.sqlite

# --- Community tasks (optional) ---
# Channel for the "subscribe" task. The bot MUST be an admin of this channel.
CHANNEL=
CHANNEL_URL=
CHAT_URL=
X_URL=

# --- Season / token (optional) ---
SEASON_NAME=Season 0
TOKEN_SYMBOL=OFFICE

# --- Economy tuning (optional, defaults are the documented values) ---
# POINTS_DAILY_D=300
# REF_L1=0.10
# REF_L2=0.02
# REF_DAILY_CAP=150
# INVITE_CASH=500
# INVITE_GEMS=2
# WELCOME_CASH=300

# --- Rewarded ads (optional) ---
# Monetag (monetag.com): zone id of a "Rewarded Interstitial" zone for Telegram Mini Apps, and the SDK script src from your tag
MONETAG_ZONE=
MONETAG_SDK_URL=https://libtl.com/sdk.js
# Optional postback secret. Monetag postback URL to set in the dashboard:
#   https://YOUR-DOMAIN/api/ads/monetag?key=THIS_SECRET&ymid={ymid}&rt={reward_event_type}&et={event_type}
MONETAG_POSTBACK_KEY=
# Adsgram (partner.adsgram.ai) — used only if MONETAG_ZONE is empty
# Block id of a "Reward" ad block. Empty = no ad button in the game.
ADSGRAM_BLOCK_ID=
# Limits: ads per player per day, seconds between ads, airdrop points per ad, estimated revenue per view (USD)
ADS_PER_DAY=8
ADS_COOLDOWN_SEC=45
ADS_POINTS=4
ADS_USD_PER_VIEW=0.001
# Optional: if the ad network can call your server after a full view, set a secret and use the URL
#   https://YOUR-DOMAIN/api/ads/cb?key=THIS_SECRET&uid=[userId]
# then rewards are granted ONLY by that callback (strongest anti-cheat).
ADS_CALLBACK_KEY=

# --- Anti-bot (optional) ---
# Cloudflare Turnstile keys add an invisible captcha to the human check
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=

# --- Development only ---
# NEVER enable on a public server: accepts logins without Telegram signature (open http://localhost:8080/?dev=1)
DEV_AUTH=0
