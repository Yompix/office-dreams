msgstr "«Витрата батареї» → LANTERN"

msgid "«Резервная копия» на экране мира — или скачайте по коду"
msgstr "«Резервна копія» на екрані світу — або завантажте за кодом"

msgid "«Серверы» → «Добавить сервер»: адрес 127.0.0.1, порт %d"
msgstr "«Сервери» → «Додати сервер»: адреса 127.0.0.1, порт %d"

