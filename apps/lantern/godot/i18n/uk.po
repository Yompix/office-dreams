msgstr "%s не пускав білий список — LANTERN вимкнув його. Нехай %s зайде ще раз"

msgid "%s принял(а) вашу заявку!"
msgstr "%s прийняв(ла) вашу заявку!"

msgid "%s пришёл со старой версией Minecraft. Пусть выберет в лаунчере ту же версию, что у сервера."
msgstr "%s прийшов зі старою версією Minecraft. Нехай вибере в лаунчері ту саму версію, що й у сервера."

msgid "%s пришёл со старой версией Minecraft. Сервер на версии %s — пусть выберет в лаунчере версию %s."
msgstr "%s прийшов зі старою версією Minecraft. Сервер на версії %s — нехай вибере в лаунчері версію %s."

msgid "%s разбанен — пусть зайдёт ещё раз"
msgstr "%s розбанений — нехай зайде ще раз"

