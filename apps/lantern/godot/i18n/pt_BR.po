msgid "\n----- прошлый запуск -----\n"
msgstr "\n----- прошлый запуск -----\n"

msgid "\nНажмите «Запустить» ещё раз. Не помогло — «Сообщить о проблеме» ниже, мы разберёмся."
msgstr "\nToque em “Iniciar” de novo. Não resolveu? Use “Relatar um problema” abaixo e a gente resolve."

msgid "\nНет прав на запись — выберите другую папку в «Настройках»."
msgstr "\nSem permissão de escrita — escolha outra pasta em Configurações."

msgid "  (ДЕМО)"
msgstr "  (DEMO)"

msgid "  · код "
msgstr "  · código "

msgid " («Видимость для игроков LAN» включена)."
msgstr " (“Visível para jogadores da LAN” está ativado)."

msgid " («Открыть для сети»)."
msgstr " (“Abrir para LAN”)."

msgid " (ДЕМО)"
msgstr " (DEMO)"

msgid " (вы)"
msgstr " (você)"

msgid " (или Esc)."
msgstr " (ou Esc)."

