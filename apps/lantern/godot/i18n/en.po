msgstr "At the very bottom — “%s”. Press “Play”"

msgid "В списке её нет. Зайдут только те, кому вы отправите код или ссылку."
msgstr "Not listed. Only people you send the code or link to can join."

msgid "В той же Wi-Fi сети"
msgstr "On the same Wi-Fi"

msgid "В чате появится «Локальный сервер запущен на порту …»."
msgstr "The chat will show “Local game hosted on port …”."

msgid "Важно знать"
msgstr "Good to know"

msgid "Вас позвал друг?"
msgstr "Invited by a friend?"

msgid "Ваш QR-код"
msgstr "Your QR code"

