msgstr "No ads, your own room code, cloud world backups, special cosmetics"

msgid "Без сдвигов и вспышек — для слабых телефонов и тех, кого укачивает."
msgstr "No slides or flashes — for slow phones and motion-sensitive people."

msgid "Без телеметрии. Не требует прав администратора. Пароли не спрашивает."
msgstr "No telemetry. No admin rights needed. Never asks for passwords."

msgid "Бесплатно"
msgstr "Free"

msgid "Больше мест (+5)"
msgstr "More slots (+5)"

msgid "Большие биомы"
msgstr "Large biomes"

msgid "Брандмауэр"
