msgstr "[LANTERN] Code for friends: %s"

msgid "«Авто» — LANTERN сам подберёт под ваш компьютер."
msgstr "“Auto” — LANTERN picks what fits your computer."

msgid "«Автозапуск»"
msgstr "“Autostart”"

msgid "«Батарея» → LANTERN"
msgstr "“Battery” → LANTERN"

