msgstr "BOOM! ✦"

msgid "Баланс"
msgstr "Balanced"

msgid "Батарея"
msgstr "Battery"

msgid "Без профиля список игр не виден."
msgstr "Without a profile the game list is hidden."

msgid "Без рекламы совсем"
msgstr "No ads at all"

