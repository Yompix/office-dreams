msgstr "Java: installed Paper %s build %d — %s"

msgid "LANTERN Pro — месяц"
msgstr "LANTERN Pro — one month"

msgid "LANTERN всё равно скачает свою, если миру нужна версия новее."
msgstr "LANTERN will still download its own if the world needs a newer version."

msgid "LANTERN держит связь с миром друга, пока вы играете."
msgstr "LANTERN keeps the link to your friend's world while you play."

msgid "LANTERN ищет мир на этом "
msgstr "LANTERN is looking for a world on this "

