msgstr "Your friend %s played for an hour — +%d sparks for you!"

msgid "Ваш код комнаты: "
msgstr "Your room code: "

msgid "Ваш мир «%s»"
msgstr "Your world “%s”"

msgid "Ваш мир из Minecraft или отдельный сервер — друзья зайдут по коду"
msgstr "Your Minecraft world or a separate server — friends join by code"

msgid "Ваш ник в Minecraft"
msgstr "Your Minecraft nickname"

msgid "Ваш тег"
msgstr "Your tag"

