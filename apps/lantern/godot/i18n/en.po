msgstr "LANTERN is updating. Try again in a minute."

msgid "LANTERN понимает и новый способ открытия мира (NetherNet, 2025+), и старый (RakNet). Друзьям нужна та же версия, что у вас."
msgstr "LANTERN supports both the new way of opening a world (NetherNet, 2025+) and the old one (RakNet). Friends need the same version as you."

msgid "LANTERN — мир"
msgstr "LANTERN — world"

msgid "Minecraft (Bedrock) не найден. Откройте игру сами и зайдите в мир — LANTERN его увидит."
msgstr "Minecraft (Bedrock) not found. Open the game yourself and enter a world — LANTERN will see it."

msgid "Minecraft Bedrock на этом компьютере"
msgstr "Minecraft Bedrock on this computer"

msgid "Minecraft Java (ПК)"
msgstr "Minecraft Java (PC)"

msgid "Minecraft Java на этом компьютере"
msgstr "Minecraft Java on this computer"

msgid "Minecraft из Microsoft Store (Bedrock) откроется и сам зайдёт в мир. Играете в Java — смотрите ниже."
msgstr "Minecraft from Microsoft Store (Bedrock) will open and join the world by itself. Playing Java? See below."

msgid "Minecraft из Microsoft Store на Windows 10/11"
msgstr "Minecraft from Microsoft Store on Windows 10/11"

msgid "Minecraft из лаунчера на ПК (Java Edition)"
msgstr "Minecraft from the launcher on PC (Java Edition)"

msgid "Minecraft не отвечает. Вернитесь в игру и проверьте, что мир открыт"
msgstr "Minecraft isn't responding. Go back to the game and check that the world is open"

msgid "Minecraft не отвечает. Вернитесь в мир"
msgstr "Minecraft isn't responding. Go back to the world"

msgid "Minecraft не отвечает. Вернитесь в мир."
msgstr "Minecraft isn't responding. Go back to the world."

msgid "Minecraft открыт"
msgstr "Minecraft is open"

msgid "Minecraft открыт — заходим в мир «%s»."
msgstr "Minecraft is open — joining the world “%s”."

msgid "Minecraft — на экране, LANTERN не закрывайте"
msgstr "Keep Minecraft on screen and don't close LANTERN"

msgid "Minecraft — товарный знак Mojang Synergies AB. LANTERN не содержит файлов игры: нужна своя копия Minecraft."
msgstr "Minecraft is a trademark of Mojang Synergies AB. LANTERN contains no game files: you need your own copy of Minecraft."

msgid "Paper %s сборка %s"
msgstr "Paper %s build %s"

