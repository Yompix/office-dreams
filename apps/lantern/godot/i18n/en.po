msgstr "Turn on “Display pop-up windows while running in the background” and “Pop-up windows”"

msgid "Включите «Разрешить работу в фоне»"
msgstr "Turn on “Allow background activity”"

msgid "Включите режим «Быстро»: мир будет видно чуть ближе, зато без рывков."
msgstr "Switch to “Fast”: you'll see a bit less of the world, but no stutter."

msgid "Включите — иначе система выгрузит LANTERN, пока вы играете"
msgstr "Turn it on — otherwise the system will unload LANTERN while you play"

msgid "Вместе с вами."
msgstr "Including you."

msgid "Внешний вид"
msgstr "Appearance"

msgid "Внизу, в «Играх по сети рядом», — «%s». Нажмите на него"
msgstr "At the bottom, under “LAN Games”, find “%s”. Tap it"

msgid "Во что играем?"
msgstr "What are we playing?"

msgid "Войти"
msgstr "Join"

msgid "Восстановить"
msgstr "Restore"

