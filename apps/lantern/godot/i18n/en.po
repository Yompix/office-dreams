msgstr "Top row — free rewards, bottom row — premium."

msgid "Вещи остаются после смерти"
msgstr "Keep items after death"

msgid "Взрывы ломают блоки"
msgstr "Explosions break blocks"

msgid "Видимость для игроков LAN"
msgstr "Visible to LAN Players"

msgid "Включена «Видимость для игроков LAN»"
msgstr "“Visible to LAN Players” is on"

