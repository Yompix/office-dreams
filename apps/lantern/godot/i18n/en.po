msgstr "“For everyone” — PC, phones and consoles in one world. “Bedrock only” — the official server for phones and consoles."

msgid "«Добавить сервер»: адрес 127.0.0.1, порт %d"
msgstr "“Add Server”: address 127.0.0.1, port %d"

msgid "«Другие разрешения»"
msgstr "“Other permissions”"

