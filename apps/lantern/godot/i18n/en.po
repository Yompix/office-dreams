msgstr "All blocks at once, you can fly, nobody dies."

msgid "Все в LANTERN"
msgstr "Everyone in LANTERN"

msgid "Все в одном мире: Java от 1.8.9 до новейшей, телефоны, Windows и консоли — с актуальной версией Minecraft. Ничего настраивать не нужно."
msgstr "Everyone in one world: Java from 1.8.9 to the latest, phones, Windows and consoles — on the current Minecraft version. Nothing to set up."

msgid "Все места заняты"
msgstr "All slots are taken"

msgid "Все места заняты."
msgstr "All slots are taken."

msgid "Все режимы"
msgstr "All modes"

