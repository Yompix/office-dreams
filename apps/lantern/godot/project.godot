; LANTERN — by Yompix
config_version=5

[application]

config/name="LANTERN"
config/description="LANTERN — игра с друзьями по коду комнаты (для Minecraft: Java и Bedrock). Неофициальное приложение. by Yompix"
config/version="1.7.0"
run/main_scene="res://main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="LANTERN"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/low_processor_mode=true
run/flush_stdout_on_print=true
boot_splash/bg_color=Color(0.0314, 0.0392, 0.0784, 1)
boot_splash/show_image=false
config/icon="res://icon.png"
config/windows_native_icon="res://icon.ico"

[autoload]

Cfg="*res://scripts/core/config.gd"
Net="*res://scripts/core/net.gd"
Social="*res://scripts/social/social_client.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/energy_saving/keep_screen_on=false
window/stretch/mode.mobile="canvas_items"
window/stretch/aspect.mobile="expand"
window/handheld/orientation=6
window/per_pixel_transparency/allowed=true

[editor_plugins]

enabled=PackedStringArray("res://addons/lantern_android/plugin.cfg")

[gui]

common/snap_controls_to_pixels=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.0314, 0.0392, 0.0784, 1)

[debug]

gdscript/warnings/inference_on_variant=1
