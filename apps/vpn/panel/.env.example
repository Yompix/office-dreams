# Название сервиса (в боте, в приложениях, на странице подписки)
BRAND=YURK
# Бот из @BotFather. Никому не показывать.
BOT_TOKEN=
BOT_USERNAME=yurkvpn_bot
# Адрес панели (https). Лучше свой домен: *.up.railway.app в некоторых странах блокируют.
PUBLIC_URL=https://vpn.example.com
# Ваш Telegram id (узнать: @userinfobot). Через запятую, если админов несколько.
ADMIN_IDS=
# Ключ для /admin/stats: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_KEY=
# Поддержка: @username или https-ссылка (необязательно)
SUPPORT=
TRIAL_DAYS=3
REF_DAYS=7
# Тарифы (звёзды Telegram). По умолчанию: месяц 150, 3 месяца 400, год 1400
# PLANS=[{"id":"m1","days":30,"stars":150},{"id":"m3","days":90,"stars":400},{"id":"y1","days":365,"stars":1400}]
# База (на Railway — Volume с путём /data, тогда указывать не нужно)
# DB_PATH=/data/vpn.db
